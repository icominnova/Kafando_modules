<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_fuel_expense_document">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">

                <t t-call="web.external_layout">

                    <div class="page">

                        <div class="text-center mb-4">
                            <h2>
                                EXPENSE VOUCHER
                            </h2>

                            <h4>
                                <span t-field="o.name"/>
                            </h4>
                        </div>

                        <div class="row mt-4">

                            <div class="col-6">
                                <strong>Expense Date:</strong>
                                <span t-field="o.date"/>
                            </div>

                            <div class="col-6">
                                <strong>Fuel Station:</strong>
                                <span t-field="o.station_id"/>
                            </div>

                        </div>

                        <div class="row mt-3">

                            <div class="col-6">
                                <strong>Expense Category:</strong>
                                <span t-field="o.category_id"/>
                            </div>

                            <div class="col-6">
                                <strong>Shift:</strong>

                                <t t-if="o.shift_id">
                                    <span t-field="o.shift_id"/>
                                </t>

                                <t t-else="">
                                    -
                                </t>
                            </div>

                        </div>

                        <div class="row mt-3">

                            <div class="col-12">
                                <strong>Description:</strong>
                                <span t-field="o.description"/>
                            </div>

                        </div>

                        <div class="row mt-4">

                            <div class="col-6">
                                <strong>Payment Source:</strong>
                                <span t-field="o.payment_source"/>
                            </div>

                            <div class="col-6">
                                <strong>Amount:</strong>

                                <span t-field="o.amount"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </div>

                        </div>


                        <hr class="my-4"/>


                        <div class="row">

                            <div class="col-6">
                                <strong>Recorded By:</strong>
                                <span t-field="o.user_id"/>
                            </div>

                            <div class="col-6">
                                <strong>Status:</strong>
                                <span t-field="o.state"/>
                            </div>

                        </div>

                        <div class="row mt-3">

                            <div class="col-6">
                                <strong>Approved By:</strong>

                                <t t-if="o.approved_by">
                                    <span t-field="o.approved_by"/>
                                </t>

                                <t t-else="">
                                    -
                                </t>
                            </div>

                            <div class="col-6">
                                <strong>Approval Date:</strong>

                                <t t-if="o.approved_date">
                                    <span t-field="o.approved_date"/>
                                </t>

                                <t t-else="">
                                    -
                                </t>
                            </div>

                        </div>


                        <t t-if="o.notes">

                            <div class="mt-4">

                                <strong>Notes:</strong>

                                <div class="mt-2">
                                    <span t-field="o.notes"/>
                                </div>

                            </div>

                        </t>


                        <div class="row"
                             style="margin-top: 80px;">

                            <div class="col-6 text-center">

                                <strong>
                                    Manager Signature
                                </strong>

                                <div style="margin-top: 60px;">
                                    __________________________
                                </div>

                            </div>

                            <div class="col-6 text-center">

                                <strong>
                                    Station Stamp / Signature
                                </strong>

                                <div style="margin-top: 60px;">
                                    __________________________
                                </div>

                            </div>

                        </div>

                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>
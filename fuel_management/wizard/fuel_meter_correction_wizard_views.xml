<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fuel_meter_correction_wizard_form" model="ir.ui.view">
        <field name="name">fuel.meter.correction.wizard.form</field>
        <field name="model">fuel.meter.correction.wizard</field>

        <field name="arch" type="xml">

            <form string="Correct Closing Index">

                <group>
                    <field name="shift_id"/>
                    <field name="reading_id"/>
                    <field name="opening_reading" invisible="not reading_id"/>
                    <field name="old_closing_reading" invisible="not reading_id"/>
                    <field name="old_dispensed_qty" invisible="not reading_id"/>
                </group>

                <group string="Correction">
                    <field name="new_closing_reading"/>
                    <field name="new_dispensed_qty"/>
                    <field name="stock_adjustment_qty"/>
                    <field name="reason"
                           placeholder="Explain the reason for this correction..."/>
                </group>

                <footer>

                    <button
                        name="action_confirm"
                        string="Apply Correction"
                        type="object"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>
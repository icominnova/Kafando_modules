<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fuel_shift_validation_wizard_form" model="ir.ui.view">
        <field name="name">fuel.shift.validation.wizard.form</field>
        <field name="model">fuel.shift.validation.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Validation">
                <group>
                    <field name="shift_id" invisible="1"/>
                    <div class="text-center">
                        <h4>
                            Please verify your closing indexes before validation.
                        </h4>
                    </div>
                </group>

                <footer>
                    <button name="action_confirm"
                            string="Validate"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
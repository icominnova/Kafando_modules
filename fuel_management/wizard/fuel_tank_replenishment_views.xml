<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fuel_tank_replenishment_form" model="ir.ui.view">
        <field name="name">fuel.tank.replenishment.form</field>
        <field name="model">fuel.tank.replenishment</field>
        <field name="arch" type="xml">
            <form string="Replenish Tank">
                <group>
                    <field name="tank_id"/>
                    <field name="station_id" readonly="1"/>
                    <field name="shift_id"/>
                    <field name="quantity"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm"
                        class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fuel_tank_replenishment" model="ir.actions.act_window">
        <field name="name">Replenish Tank</field>
        <field name="res_model">fuel.tank.replenishment</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
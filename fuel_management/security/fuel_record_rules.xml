<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <!-- Station rules -->
    <record id="fuel_station_allowed_station_rule" model="ir.rule">
        <field name="name">Fuel Station - Allowed Stations</field>
        <field name="model_id"
               ref="model_fuel_station"/>
        <field name="groups"
               eval="[(4, ref('group_fuel_user'))]"/>
        <field name="domain_force">
            [('id', 'in', user.fuel_station_ids.ids)]
        </field>
    </record>
    <record id="fuel_station_admin_all_rule" model="ir.rule">
        <field name="name">Fuel Station - Administrator All Stations</field>
        <field name="model_id"
               ref="model_fuel_station"/>
        <field name="groups"
               eval="[(4, ref('group_fuel_admin'))]"/>
        <field name="domain_force">
            [(1, '=', 1)]
        </field>
    </record>


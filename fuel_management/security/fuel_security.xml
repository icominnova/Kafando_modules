<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- Fuel Management Privilege (visible category in Settings > Users) -->
        <record id="res_groups_privilege_fuel_management" model="res.groups.privilege">
            <field name="name">Fuel Management</field>
            <field name="category_id" ref="base.module_category_supply_chain"/>
            <field name="sequence">100</field>
        </record>

        <!-- Groups -->
        <record id="group_fuel_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_fuel_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="sequence">10</field>
        </record>

         <record id="group_fuel_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_fuel_management"/>
            <field name="implied_ids" eval="[(4, ref('group_fuel_user'))]"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_fuel_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_fuel_management"/>
            <field name="implied_ids" eval="[(4, ref('group_fuel_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="sequence">30</field>
        </record>

        <!-- MULTI-COMPANY RECORD RULES -->
        <data noupdate="1">
        <record id="fuel_station_company_rule" model="ir.rule">
            <field name="name">Fuel Station - Active Company</field>
            <field name="model_id" ref="model_fuel_station"/>
            <field name="domain_force">[('company_id', '=', company_id)]</field>
        </record>

        <record id="fuel_tank_company_rule" model="ir.rule">
            <field name="name">Fuel Tank - Active Company</field>
            <field name="model_id" ref="model_fuel_tank"/>
            <field name="domain_force">[('station_id.company_id', '=', company_id)]</field>
        </record>

        <record id="fuel_pump_company_rule" model="ir.rule">
            <field name="name">Fuel Pump - Active Company</field>
            <field name="model_id" ref="model_fuel_pump"/>
            <field name="domain_force">[('station_id.company_id', '=', company_id)]</field>
        </record>

        <record id="fuel_nozzle_company_rule" model="ir.rule">
            <field name="name">Fuel Nozzle - Active Company</field>
            <field name="model_id" ref="model_fuel_nozzle"/>
            <field name="domain_force">[('station_id.company_id', '=', company_id)]</field>
        </record>

        <record id="fuel_shift_company_rule" model="ir.rule">
            <field name="name">Fuel Shift - Active Company</field>
            <field name="model_id" ref="model_fuel_shift"/>
            <field name="domain_force">[('station_id.company_id', '=', company_id)]</field>
        </record>

        <record id="fuel_meter_reading_company_rule" model="ir.rule">
            <field name="name">Fuel Meter Reading - Active Company</field>
            <field name="model_id" ref="model_fuel_meter_reading"/>
            <field name="domain_force">[('station_id.company_id', '=', company_id)]</field>
        </record>

        <record id="fuel_dip_reading_company_rule" model="ir.rule">
            <field name="name">Fuel Dip Reading - Active Company</field>
            <field name="model_id" ref="model_fuel_dip_reading"/>
            <field name="domain_force">[('station_id.company_id', '=', company_id)]</field>
        </record>

        <record id="fuel_license_company_rule" model="ir.rule">
            <field name="name">Fuel License - Active Company</field>
            <field name="model_id" ref="model_fuel_license"/>
            <field name="domain_force">[('station_id.company_id', '=', company_id)]</field>
        </record>

        <record id="fuel_collection_company_rule" model="ir.rule">
            <field name="name">Fuel Collection - Active Company</field>
            <field name="model_id" ref="model_fuel_collection"/>
            <field name="domain_force">
                [('company_id', '=', company_id)]
            </field>
        </record>

        <!-- Tank Replenishment - Multi-company -->
        <record id="fuel_tank_replenishment_company_rule" model="ir.rule">
            <field name="name">Fuel Tank Replenishment - Active Company</field>
            <field name="model_id" ref="model_fuel_tank_replenishment"/>
            <field name="domain_force">
                [('company_id', '=', company_id)]
            </field>
        </record>


        <!-- Meter Correction - Multi-company -->
        <record id="fuel_meter_correction_company_rule" model="ir.rule">
            <field name="name">Fuel Meter Correction - Active Company</field>
            <field name="model_id" ref="model_fuel_meter_correction"/>
            <field name="domain_force">
                [('company_id', '=', company_id)]
            </field>
        </record>

        <record id="fuel_expense_company_rule" model="ir.rule">
            <field name="name">Fuel Expense - Active Company</field>
            <field name="model_id" ref="model_fuel_expense"/>
            <field name="domain_force">
                [('company_id', '=', company_id)]
            </field>
        </record>

        <record id="fuel_expense_category_company_rule" model="ir.rule">
            <field name="name">Fuel Expense Category - Active Company</field>
            <field name="model_id" ref="model_fuel_expense_category"/>
            <field name="domain_force">
                [('company_id', '=', company_id)]
            </field>
        </record>

    </data>
</odoo>

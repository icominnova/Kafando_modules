<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_fuel_shift" model="ir.sequence">
            <field name="name">Fuel Shift</field>
            <field name="code">fuel.shift</field>
            <field name="prefix">SHF/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
    <record id="seq_fuel_expense" model="ir.sequence">
        <field name="name">Fuel Expense</field>
        <field name="code">fuel.expense</field>
        <field name="prefix">FEXP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LISTE DES REAPPROVISIONNEMENTS -->
    <record id="view_fuel_tank_replenishment_list" model="ir.ui.view">
        <field name="name">fuel.tank.replenishment.list</field>
        <field name="model">fuel.tank.replenishment</field>
        <field name="arch" type="xml">

            <list decoration-success="state == 'done'">
                <field name="receipt_id"
                    string="Receipt"/>
                <field name="station_id"
                    string="Station"/>
                <field name="tank_id"
                    string="Tank"/>
                <field name="product_id"
                    string="Product"/>
                <field name="quantity"
                    string="Quantity (L)"/>
                <field name="remaining_after_qty"
                    string="Remaining (L)"/>
            </list>

        </field>
    </record>


    <!-- FORMULAIRE -->
    <record id="view_fuel_tank_replenishment_form" model="ir.ui.view">
        <field name="name">fuel.tank.replenishment.form</field>
        <field name="model">fuel.tank.replenishment</field>
        <field name="arch" type="xml">

            <form string="Tank Replenishment">

                <header>
                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"/>

                    <button
                        name="action_cancel"
                        string="Cancel Replenishment"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'done'"
                        confirm="Are you sure you want to cancel this replenishment?"/>

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,done,cancelled"/>

                </header>

                <sheet>
                    <group>
                        <!-- RECEPTION -->
                        <group string="Validated Receipt">
                            <field
                                name="receipt_id"
                                options="{'no_create': True}"
                                readonly="state == 'done'"/>
                            <field
                                name="purchase_order_id"
                                readonly="1"/>
                            <field
                                name="product_id"
                                readonly="1"/>
                            <field
                                name="received_qty"
                                readonly="1"/>
                            <field
                                name="already_replenished_qty"
                                readonly="1"/>
                            <field
                                name="remaining_qty"
                                readonly="1"/>
                        </group>


                        <!-- REAPPROVISIONNEMENT -->
                        <group string="Replenishment">

                            <field
                                name="tank_id"
                                domain="[('product_id', '=', product_id)]"
                                readonly="state == 'done'"/>
                            <field
                                name="station_id"
                                readonly="1"/>
                            <field
                                name="shift_id"
                                readonly="state == 'done'"/>
                            <field
                                name="quantity"
                                readonly="state == 'done'"/>
                            <field
                                name="remaining_after_qty"
                                readonly="1"
                                invisible="state == 'draft'"/>
                        </group>
                    </group>

                    <group>
                        <group string="Tracking">
                            <field
                                name="date"
                                readonly="1"/>
                            <field
                                name="user_id"
                                readonly="1"/>
                            <field
                                name="company_id"
                                readonly="1"/>
                            <field name="confirmed_by"
                                readonly="1"
                                invisible="state == 'draft'"/>

                            <field name="confirmed_date"
                                readonly="1"
                                invisible="state == 'draft'"/>
                        </group>
                    </group>

                    <group string="Notes">
                        <field
                            name="notes"
                            nolabel="1"
                            readonly="state == 'done'"/>
                    </group>
                    <group string="Cancellation"
                        invisible="state == 'draft'">

                        <field name="cancel_reason"
                            placeholder="Explain why this replenishment is being cancelled..."
                            readonly="state == 'cancelled'"/>

                        <field name="cancelled_by"
                            readonly="1"
                            invisible="state != 'cancelled'"/>

                        <field name="cancelled_date"
                            readonly="1"
                            invisible="state != 'cancelled'"/>

                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- RECHERCHE -->
    <record id="view_fuel_tank_replenishment_search" model="ir.ui.view">
        <field name="name">fuel.tank.replenishment.search</field>
        <field name="model">fuel.tank.replenishment</field>
        <field name="arch" type="xml">

            <search>

                <field name="receipt_id"/>
                <field name="purchase_order_id"/>
                <field name="station_id"/>
                <field name="tank_id"/>
                <field name="product_id"/>
                <field name="shift_id"/>
                <field name="user_id"/>

                <separator/>

                <filter
                    string="Draft"
                    name="draft"
                    domain="[('state', '=', 'draft')]"/>

                <filter
                    string="Done"
                    name="done"
                    domain="[('state', '=', 'done')]"/>

                <separator/>

                <group>

                    <filter
                        string="Station"
                        name="group_station"
                        domain="[]"
                        context="{'group_by': 'station_id'}"/>

                    <filter
                        string="Tank"
                        name="group_tank"
                        domain="[]"
                        context="{'group_by': 'tank_id'}"/>

                    <filter
                        string="Product"
                        name="group_product"
                        domain="[]"
                        context="{'group_by': 'product_id'}"/>

                    <filter
                        string="Shift"
                        name="group_shift"
                        domain="[]"
                        context="{'group_by': 'shift_id'}"/>

                </group>

            </search>

        </field>
    </record>

    <!-- ACTION -->
    <record id="action_fuel_tank_replenishment" model="ir.actions.act_window">
        <field name="name">Replenishments</field>
        <field name="res_model">fuel.tank.replenishment</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_cost_stock_visibility" model="ir.ui.view">
        <field name="name">sale.order.form.cost.stock.visibility</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='purchase_price']" position="replace">
                <field name="purchase_price" string="Coût" optional="show"/>
            </xpath>

            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="after">
                <field name="product_qty_available" string="Stock dispo." optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
